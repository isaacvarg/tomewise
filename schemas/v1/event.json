{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomewise format v1: Event envelope (one line of events/*.jsonl)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "attempt",
        "session.start",
        "session.end",
        "lesson.completed",
        "explanation.saved",
        "explanation.graded",
        "milestone.status",
        "goal.changed",
        "streak.changed"
      ]
    },
    "ref": {
      "type": "string",
      "pattern": "^(?:item|lesson|drill|quiz|exam|milestone|event):.+$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "duration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "string",
      "enum": [
        "correct",
        "wrong",
        "skipped"
      ]
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "data": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "ts",
    "subject",
    "kind",
    "schemaVersion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "attempt"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:item):.+$"
          }
        },
        "required": [
          "ref",
          "sessionId",
          "outcome",
          "grade"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session.start"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:lesson|drill|quiz|exam):.+$"
          }
        },
        "required": [
          "ref",
          "sessionId"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session.end"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:lesson|drill|quiz|exam):.+$"
          }
        },
        "required": [
          "ref",
          "sessionId",
          "duration"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lesson.completed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:lesson):.+$"
          }
        },
        "required": [
          "ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "explanation.saved"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:lesson|item):.+$"
          }
        },
        "required": [
          "ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "explanation.graded"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:event):.+$"
          }
        },
        "required": [
          "ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "milestone.status"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(?:milestone):.+$"
          }
        },
        "required": [
          "ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "goal.changed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "ref"
              ]
            },
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "streak.changed"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "ref"
              ]
            },
            {
              "required": [
                "grade"
              ]
            }
          ]
        }
      }
    }
  ]
}
