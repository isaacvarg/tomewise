{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomewise format v1: tomewise.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "timezone": {
      "type": "string"
    },
    "weekStart": {
      "default": "monday",
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ]
    },
    "minimumSessionSeconds": {
      "default": 60,
      "type": "number",
      "minimum": 0
    },
    "streak": {
      "default": {
        "restDaysPerWeek": 0
      },
      "type": "object",
      "properties": {
        "restDaysPerWeek": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "default": "paper",
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.-]*$"
    },
    "start": {
      "default": "sequence",
      "description": "What Start does: run what's due in sequence, or ask which subject to practise.",
      "type": "string",
      "enum": [
        "sequence",
        "ask"
      ]
    },
    "subjects": {
      "default": [],
      "description": "Subject ids in the order the home shows them. Unlisted subjects follow alphabetically.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][\\w.-]*$"
      }
    },
    "git": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the app syncs the learning home with git.",
          "type": "boolean"
        },
        "cadence": {
          "default": "session",
          "description": "When the app commits events: after each session, at the top of each hour, or at midnight in the learning home's timezone.",
          "type": "string",
          "enum": [
            "session",
            "hourly",
            "daily"
          ]
        },
        "remote": {
          "description": "Name of the git remote to pull from and push to, such as \"origin\". The remote itself is set up in each clone with git remote add. Without one the app only commits.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][\\w.-]*$"
        },
        "branch": {
          "description": "Branch to pull and push. Defaults to the checked-out branch.",
          "type": "string",
          "pattern": "^(?!.*\\.\\.)(?!.*\\/\\.)(?!.*\\.lock(?:\\/|$))\\w[\\w.-]*(?:\\/[\\w.-]+)*(?<!\\.)$"
        },
        "push": {
          "default": false,
          "description": "Whether the app pushes its history commits, after each commit and after each pull. Needs a remote.",
          "type": "boolean"
        },
        "pullIntervalMinutes": {
          "default": 5,
          "description": "Minutes between pulls from the remote.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "additionalProperties": false,
      "description": "Git sync settings. Leave the block out to keep git sync off; a block turns it on unless enabled is false.",
      "if": {
        "properties": {
          "push": {
            "const": true
          }
        },
        "required": [
          "push"
        ]
      },
      "then": {
        "required": [
          "remote"
        ]
      }
    },
    "assessments": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean",
          "description": "Whether the subject has quizzes and exams at all."
        },
        "quizFrequency": {
          "default": {
            "every": 5
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "every": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Completed lessons between quizzes."
                }
              },
              "required": [
                "every"
              ],
              "additionalProperties": false
            },
            {
              "type": "string",
              "enum": [
                "weekly",
                "onDemand"
              ]
            }
          ],
          "description": "When a quiz is due: every N completed lessons ({ \"every\": N }), weekly from weekStart, or only when asked (\"onDemand\")."
        },
        "quizLength": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Questions in an app-built quiz."
        },
        "exams": {
          "default": true,
          "type": "boolean",
          "description": "Whether milestones have exams. With exams off, milestones are marked done by hand."
        },
        "timed": {
          "default": false,
          "anyOf": [
            {
              "type": "boolean",
              "const": false
            },
            {
              "type": "object",
              "properties": {
                "minutes": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Time limit in minutes."
                }
              },
              "required": [
                "minutes"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Whether quizzes and exams have a time limit: false, or { \"minutes\": N }."
        },
        "scoreDisplay": {
          "default": "number",
          "type": "string",
          "enum": [
            "number",
            "pass-fail",
            "hidden"
          ],
          "description": "How a score is shown: the number, pass or fail only, or not at all."
        },
        "passMark": {
          "default": 70,
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Lowest score, as a percentage, that passes. Passing means score ≥ pass mark."
        }
      },
      "additionalProperties": false,
      "description": "Quiz and exam settings for every subject. A subject can override any of them in subject.json."
    },
    "vault": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the app writes Obsidian-friendly notes alongside the plain files.",
          "type": "boolean"
        },
        "notesFolder": {
          "default": "sessions",
          "description": "Folder inside the learning home, relative to tomewise.json, that holds the generated session notes.",
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\\\:]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\:]+)*\\/?$"
        }
      },
      "additionalProperties": false,
      "description": "Vault mode settings. Leave the block out to keep vault mode off; a block turns it on unless enabled is false."
    }
  },
  "required": [
    "formatVersion"
  ],
  "additionalProperties": false
}
