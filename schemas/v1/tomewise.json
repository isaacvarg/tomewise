{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomewise format v1: tomewise.json",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "timezone": {
      "type": "string"
    },
    "weekStart": {
      "default": "monday",
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ]
    },
    "minimumSessionSeconds": {
      "default": 60,
      "type": "number",
      "minimum": 0
    },
    "streak": {
      "default": {
        "restDaysPerWeek": 0
      },
      "type": "object",
      "properties": {
        "restDaysPerWeek": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "default": "paper",
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.-]*$"
    }
  },
  "required": [
    "formatVersion"
  ],
  "additionalProperties": false
}
