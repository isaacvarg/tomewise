{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomewise format v1: theme.json (themes/<name>/theme.json)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "script": {
      "type": "string",
      "pattern": "^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[\\w.-]+(?:\\/[\\w.-]+)*$"
    }
  },
  "required": [
    "name",
    "author",
    "version"
  ],
  "additionalProperties": false
}
